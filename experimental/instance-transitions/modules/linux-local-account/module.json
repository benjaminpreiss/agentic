{
  "kind": "module",
  "authority": "did:web:agentic.invalid",
  "name": "linux-local-account",
  "version": 1,
  "implements": "interface/account@1",
  "requires": [
    "interface/os@1",
    "interface/login-shell@1"
  ],
  "values": {},
  "config": {
    "account_name": "string"
  },
  "methods": {
    "inspect": {
      "script": "methods/inspect.sh",
      "args": [
        "account_name",
        "shell_path"
      ]
    }
  },
  "uses": [
    {
      "interface": "interface/login-shell@1",
      "value": "path",
      "as": "shell_path"
    }
  ]
}
