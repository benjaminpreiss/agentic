{
  "kind": "module",
  "authority": "did:web:agentic.invalid",
  "name": "tumbleweed-networkd",
  "version": 1,
  "implements": "interface/networking@1",
  "requires": [
    "interface/os@1",
    "interface/bash-runtime@1",
    "interface/python-runtime@1"
  ],
  "methods": {
    "inspect": {
      "runtime": "interface/bash-runtime@1",
      "artifact": "methods/inspect.sh",
      "format": "text/x-bash",
      "grant": "network-read",
      "args": [
        "interface_name"
      ]
    },
    "configure": {
      "runtime": "interface/python-runtime@1",
      "artifact": "methods/stage.py",
      "format": "text/x-python",
      "grant": "network-stage",
      "args": [
        "interface_name",
        "network_mac",
        "network_mode",
        "static_ipv4",
        "gateway_ipv4",
        "dns_servers"
      ]
    }
  }
}
