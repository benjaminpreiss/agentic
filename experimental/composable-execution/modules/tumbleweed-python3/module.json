{
  "kind": "module",
  "authority": "did:web:agentic.invalid",
  "name": "tumbleweed-python3",
  "version": 1,
  "implements": "interface/python-runtime@1",
  "requires": [
    "interface/os@1",
    "interface/executor@1",
    "interface/package-manager@1"
  ],
  "methods": {
    "run": {
      "calls": [
        {"via": "interface/executor@1", "method": "invoke"}
      ],
      "accepts": [
        "text/x-python"
      ]
    }
  },
  "values": {
    "path": "/usr/bin/python3"
  }
}
