{
  "kind": "module",
  "authority": "did:web:agentic.invalid",
  "name": "python-on-executor",
  "version": 1,
  "implements": "interface/python-runtime@1",
  "requires": [
    "interface/executor@1",
    "interface/package-manager@1"
  ],
  "methods": {
    "run": {
      "implementation": "delegate",
      "via": "interface/executor@1",
      "accepts": [
        "text/x-python"
      ]
    }
  },
  "values": {
    "path": "/usr/bin/python3"
  }
}
