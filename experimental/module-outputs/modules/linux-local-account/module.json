{
  "id": "linux-local-account",
  "implements": "account@1",
  "entrypoint": "ensure",
  "requires": [
    "os-base@1",
    "login-shell@1"
  ],
  "inputs": {
    "account_name": {
      "type": "string",
      "source": "config"
    },
    "shell_path": {
      "type": "string",
      "from": {
        "interface": "login-shell@1",
        "method": "ensure",
        "output": "path"
      }
    }
  },
  "operations": {
    "ensure": "ensure.yml"
  }
}
